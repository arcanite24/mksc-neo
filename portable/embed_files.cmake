# cmake -DOUTPUT=FILE.c -DFILES="a|b" -P embed_files.cmake
# Writes each file as `const uint8_t portable_embed_<name>[]` plus
# `portable_embed_<name>_size`, where <name> is the file name with every
# non-alphanumeric character replaced by '_'. A NUL byte follows the data so
# embedded text can be parsed in place.
string(REPLACE "|" ";" FILES "${FILES}")
file(WRITE "${OUTPUT}.tmp" "/* Generated by portable/embed_files.cmake; do not edit. */\n#include <stddef.h>\n#include <stdint.h>\n")
foreach(path IN LISTS FILES)
    get_filename_component(name "${path}" NAME)
    string(MAKE_C_IDENTIFIER "${name}" name)
    file(READ "${path}" bytes HEX)
    string(LENGTH "${bytes}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    string(REGEX REPLACE "((0x..,){24})" "\\1\n" bytes "${bytes}")
    file(APPEND "${OUTPUT}.tmp" "const uint8_t portable_embed_${name}[] = {\n${bytes}0x00};\nconst size_t portable_embed_${name}_size = ${size};\n")
endforeach()
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
