# Shared Linux cross-target boundary. Programs (Python/CMake) run on the host;
# target libraries and headers come from the selected sysroot.
set(CMAKE_SYSTEM_NAME Linux)
find_program(CMAKE_C_COMPILER NAMES "${MKSC_CROSS_TRIPLE}-gcc" REQUIRED)
find_program(MKSC_QEMU NAMES "${MKSC_QEMU_NAME}" REQUIRED)
set(MKSC_CROSS_SYSROOT "" CACHE PATH "Optional relocated cross-toolchain sysroot")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MKSC_CROSS_SYSROOT MKSC_CROSS_RUNTIME)
if(MKSC_CROSS_SYSROOT)
    set(CMAKE_SYSROOT "${MKSC_CROSS_SYSROOT}")
    set(target_runtime "${MKSC_CROSS_SYSROOT}/usr/${MKSC_CROSS_TRIPLE}")
    set(CMAKE_C_STANDARD_INCLUDE_DIRECTORIES "${target_runtime}/include")
else()
    set(target_runtime "/usr/${MKSC_CROSS_TRIPLE}")
endif()
set(MKSC_CROSS_RUNTIME "${target_runtime}" CACHE PATH "Target runtime prefix for QEMU")
set(CMAKE_CROSSCOMPILING_EMULATOR "${MKSC_QEMU};-L;${MKSC_CROSS_RUNTIME}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
